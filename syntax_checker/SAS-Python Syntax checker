# Translated SAS to python program syntax checker
from google import genai
from google.genai import types
#from IPython.display import display, Markdown

# Initialize client (uses GEMINI_API_KEY environment variable)
client = genai.Client(api_key= "GEMINI_API_KEY")

syntaxcheck_prompt = """Please check line by line the syntax of the Python program provided below.
If you find any syntax errors, return a corrected version of the code as a clean, executable Python script (.py).
Include brief comments (#) directly above any lines you corrected to explain what was changed.
If the program has no syntax errors, return the original code unchanged with a comment at the top saying "# No syntax errors found".
"""

# Read the target Python script
with open("dummy_file", "r", encoding="utf-8") as f:
    python_code = f.read()

# Make the API call
test_response = client.models.generate_content(
    model="gemini-3.6-flash",
    contents=[syntaxcheck_prompt, f"```python\n{python_code}\n```"],
    config=types.GenerateContentConfig(
        max_output_tokens=1000,
    ),
)

# Extract and clean up output
corrected_code = test_response.text

if corrected_code.startswith("```python"):
    corrected_code = corrected_code.split("```python", 1)[1].rsplit("```", 1)[0].strip()

# Save output to a new script
with open("corrected_dummy_file.py", "w", encoding="utf-8") as f:
    f.write(corrected_code)

print("Syntax check complete! Output saved to corrected_dummy_file.py")